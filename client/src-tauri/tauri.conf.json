{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valheim Tracker Sync",
  "version": "0.1.0",
  "identifier": "io.github.yggdrion.valheimtracker.sync",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "decorations": false, "title": "Valheim Tracker Sync", "width": 1000, "height": 760, "minWidth": 420, "minHeight": 520 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCRjIxNEU5N0RERjk2NkMKUldSc2x0OTk2UlR5eTVlL1cxYzRialBkZkUzZ1Z1R1B3VmJIeXJVaFZWYmxyVFVYQzUwMjgvai8K",
      "endpoints": ["https://github.com/yggdrion/valheim-tracker/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Valheim character sync for valheim-tracker",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
